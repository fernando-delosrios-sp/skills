        <mxCell id="legend_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="680" width="220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1230" y="685" width="100" height="20" as="geometry"/>
