<mxfile host="app.diagrams.net" agent="C4 Diagram Skill" version="24.0.0" type="device">
  <diagram id="c4-container" name="harness-proxy Container Diagram">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ======================================== -->
        <!-- LAYER 1: Person (top, y ≈ 20)            -->
        <!-- ======================================== -->
        <mxCell id="person_1" value="" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;" vertex="1" parent="1">
          <mxGeometry x="680" y="20" width="40" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="person_1_label" value="&lt;b&gt;Developer or Host Agent&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;[Person / Agent]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Delegates coding sub-tasks via CLI or Agent Skill tool&lt;/font&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="580" y="85" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- LAYER 2: System Boundary (y ≈ 180-600)   -->
        <!-- ======================================== -->
        <mxCell id="boundary_1" value="harness-proxy [Software System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="1320" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="cli_router" value="&lt;b&gt;CLI &amp;amp; Dispatcher&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Go CLI]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Parses input, orchestrates classifier, quota selection, and worktree runs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="jev_client" value="&lt;b&gt;Jev Task Classifier&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Go Package]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Evaluates task complexity and selects target model tier.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="quota_engine" value="&lt;b&gt;Quota &amp;amp; Routing Engine&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Go Package]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Queries provider usage, checks tiers.yaml, and picks provider with failover.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="240" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="worktree_mgr" value="&lt;b&gt;Worktree Sandbox Manager&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: Go / Git CLI]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Creates isolated worktree branches, spawns child CLIs, and manages merge.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="local_store" value="&lt;b&gt;Local State &amp;amp; Ledger Store&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[Container: JSON / YAML / FS]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Stores ~/.config/harness-proxy/ (config, tiers.yaml, ledger.json, benchmark cache).&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438DD5;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="440" width="240" height="120" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- LAYER 3: External Systems (y ≈ 680+)     -->
        <!-- ======================================== -->
        <mxCell id="ext_git" value="&lt;b&gt;Target Git Repository&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: File System]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Repository where worktrees are mounted, committed, and merged.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#999999;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="680" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ext_jev" value="&lt;b&gt;Jev Classifier Host&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: Ollama / API]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Local LLM instance (Ollama/llama.cpp) or fallback cloud endpoint.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#999999;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="680" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ext_leaderboard" value="&lt;b&gt;Artificial Analysis API&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: HTTPS/JSON]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Coding benchmarks and intelligence index for model tier synchronization.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#999999;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="680" y="680" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ext_harnesses" value="&lt;b&gt;External Agent CLIs&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[External System: Process]&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cursor agent (-p), Antigravity agy (-p), and OpenCode Go opencode run.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;container=0;fillColor=#999999;fontColor=#ffffff;strokeColor=none;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="680" width="220" height="120" as="geometry"/>
        </mxCell>

        <!-- ======================================== -->
        <!-- CONNECTIONS                               -->
        <!-- ======================================== -->
        <mxCell id="conn_1" value="Delegates task [CLI / Subagent Tool]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="person_1" target="cli_router" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_2" value="Sends prompt for scoring [In-Memory]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="cli_router" target="jev_client" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_3" value="Scores complexity [REST / OpenAI API]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="jev_client" target="ext_jev" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_4" value="Requests provider match [In-Memory]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="cli_router" target="quota_engine" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_5" value="Reads/writes tiers &amp;amp; ledger [FS/YAML]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="quota_engine" target="local_store" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_6" value="Syncs 7-day benchmarks [HTTPS/JSON]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;dashed=1;dashPattern=5 5;labelBackgroundColor=#ffffff;" edge="1" source="quota_engine" target="ext_leaderboard" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_7" value="Spawns execution in worktree [In-Memory]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="cli_router" target="worktree_mgr" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_8" value="Provisions &amp;amp; merges worktrees [Git CLI]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="worktree_mgr" target="ext_git" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="conn_9" value="Executes headless task [Child Process / stdio]" style="endArrow=blockThin;endFill=1;fontSize=10;fontColor=#404040;strokeColor=#404040;labelBackgroundColor=#ffffff;" edge="1" source="worktree_mgr" target="ext_harnesses" parent="1">
          <mxGeometry y="-10" relative="1" as="geometry"/>
        </mxCell>

