        </mxCell>
        <mxCell id="legend_person_label" value="Person / Host Agent" style="text;html=1;fontSize=11;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1254" y="708" width="140" height="20" as="geometry"/>
