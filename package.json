{
  "name": "skills",
  "version": "0.6.0",
  "private": true,
  "description": "Curated agent skills collection compatible with npx skills",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync.mjs sync",
    "update": "node scripts/sync.mjs update",
    "import": "node scripts/sync.mjs import",
    "overlay": "node scripts/sync.mjs overlay",
    "extract-overlay": "node scripts/sync.mjs extract-overlay",
    "clean": "node scripts/sync.mjs clean",
    "install": "node scripts/install.mjs",
    "validate": "node scripts/sync.mjs validate",
    "build:harness-proxy": "cd tools/harness-proxy && go build -o ../../bin/harness-proxy ./cmd/harness-proxy",
    "test:go": "cd tools/harness-proxy && go test ./...",
    "test": "node --test"
  },
  "dependencies": {
    "@inquirer/ansi": "^2.0.7",
    "@inquirer/core": "^11.2.1",
    "@inquirer/figures": "^2.0.7",
    "@octokit/rest": "^21.0.0",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "skills": "^1.5.11",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
